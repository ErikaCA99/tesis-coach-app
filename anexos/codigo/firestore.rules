rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() { return request.auth != null; }
    function dueno(uid) { return autenticado() && request.auth.uid == uid; }
    function texto(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function numero(v, min, max) { return v is number && v >= min && v <= max; }
    function opcNumero(d, k, min, max) { return !(k in d) || numero(d[k], min, max); }
    function opcTexto(d, k, max) { return !(k in d) || texto(d[k], 0, max); }
    function creado() {
      return request.resource.data.creadoEn == request.time
        && !('actualizadoEn' in request.resource.data);
    }
    function actualizado() {
      return request.resource.data.creadoEn == resource.data.creadoEn
        && request.resource.data.actualizadoEn == request.time;
    }
    function listadoAcotado() { return request.query.limit != null && request.query.limit <= 500; }
    match /{catalogo}/{id} {
      allow get: if autenticado() && catalogo in ['maquinas', 'ejercicios', 'ejerciciosWger'];
      allow list: if autenticado() && catalogo in ['maquinas', 'ejercicios', 'ejerciciosWger'] && listadoAcotado();
    }
    match /usuarios/{uid} {
      function perfil(d) {
        return d.keys().hasOnly(['nombre', 'apellidos', 'email', 'genero', 'altura', 'pesoActual', 'edad', 'diasDisponibles', 'nivel', 'objetivo', 'rutinaActivaId', 'creadoEn', 'actualizadoEn'])
          && texto(d.nombre, 1, 100) && texto(d.email, 3, 254)
          && opcTexto(d, 'apellidos', 100)
          && opcNumero(d, 'altura', 50, 300) && opcNumero(d, 'pesoActual', 10, 500)
          && (!('edad' in d) || (d.edad is int && numero(d.edad, 14, 90)))
          && (!('diasDisponibles' in d) || (d.diasDisponibles is int && numero(d.diasDisponibles, 2, 6)))
          && (!('genero' in d) || d.genero in ['masculino', 'femenino'])
          && (!('nivel' in d) || d.nivel in ['principiante', 'intermedio', 'avanzado'])
          && (!('objetivo' in d) || d.objetivo in ['perder_peso', 'ganar_masa', 'mantenimiento', 'resistencia'])
          && (!('rutinaActivaId' in d) || d.rutinaActivaId == null ||
            (texto(d.rutinaActivaId, 1, 128) && d.rutinaActivaId.matches('^[^/]+$') &&
              exists(/databases/$(database)/documents/usuarios/$(uid)/rutinas/$(d.rutinaActivaId))));
      }
      allow get, delete: if dueno(uid);
      allow create: if dueno(uid) && perfil(request.resource.data) && creado()
        && request.resource.data.email == request.auth.token.email;
      allow update: if dueno(uid) && perfil(request.resource.data) && actualizado()
        && request.resource.data.email == resource.data.email;

      // Nested plans are validated in the authenticated guardarRutina function.
      // Admin SDK bypasses rules; the function derives UID exclusively from Auth.
      match /rutinas/{id} {
        allow get, delete: if dueno(uid);
        allow list: if dueno(uid) && listadoAcotado();
        allow create, update: if false;
      }
      match /registrosNutricionales/{id} {
        function imc(d) {
          return d.keys().hasOnly(['usuarioId', 'weight', 'height', 'bmi', 'category', 'creadoEn', 'actualizadoEn'])
            && numero(d.weight, 10, 500) && numero(d.height, 50, 300)
            && numero(d.bmi, 1, 100) && d.category in ['BAJO', 'NORMALIDAD', 'SOBREPESO', 'OBESIDAD'];
        }
        function ingesta(d) {
          return d.keys().hasOnly(['usuarioId', 'alimento', 'calorias', 'cantidad', 'proteinas', 'carbohidratos', 'grasas', 'fdcId', 'creadoEn', 'actualizadoEn'])
            && texto(d.alimento, 1, 200) && numero(d.calorias, 0, 10000)
            && opcTexto(d, 'cantidad', 100) && opcNumero(d, 'proteinas', 0, 1000)
            && opcNumero(d, 'carbohidratos', 0, 1000) && opcNumero(d, 'grasas', 0, 1000)
            && (!('fdcId' in d) || (d.fdcId is int && numero(d.fdcId, 1, 2147483647)));
        }
        function valido(d) {
          return d.usuarioId == uid && (('weight' in d && imc(d)) || ('alimento' in d && ingesta(d)));
        }
        allow get, delete: if dueno(uid);
        allow list: if dueno(uid) && listadoAcotado();
        allow create: if dueno(uid) && valido(request.resource.data) && creado();
        allow update: if dueno(uid) && valido(request.resource.data) && actualizado();
      }
      match /progresoFisico/{id} {
        function valido(d) {
          return d.keys().hasOnly(['usuarioId', 'peso', 'altura', 'imc', 'notas', 'creadoEn', 'actualizadoEn'])
            && d.usuarioId == uid && numero(d.peso, 10, 500)
            && opcNumero(d, 'altura', 50, 300) && opcNumero(d, 'imc', 0.01, 2000)
            && opcTexto(d, 'notas', 500);
        }
        allow get, delete: if dueno(uid);
        allow list: if dueno(uid) && listadoAcotado();
        allow create: if dueno(uid) && valido(request.resource.data) && creado();
        allow update: if dueno(uid) && valido(request.resource.data) && actualizado();
      }
      match /entrenamientos/{id} {
        function valido(d) {
          return d.keys().hasOnly(['usuarioId', 'rutinaId', 'dia', 'fecha', 'creadoEn', 'actualizadoEn'])
            && d.usuarioId == uid && texto(d.rutinaId, 1, 128) && d.rutinaId.matches('^[^/]+$')
            && d.dia is int && numero(d.dia, 1, 7)
            && d.fecha == id && d.fecha.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
            && exists(/databases/$(database)/documents/usuarios/$(uid)/rutinas/$(d.rutinaId));
        }
        allow get, delete: if dueno(uid);
        allow list: if dueno(uid) && listadoAcotado();
        allow create: if dueno(uid) && valido(request.resource.data) && creado();
        allow update: if dueno(uid) && valido(request.resource.data) && actualizado();
      }
    }
    // Default deny also protects server quota documents and unknown collections.
    match /{document=**} { allow read, write: if false; }
  }
}
